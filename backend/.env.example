NODE_ENV=development
PORT=5000
# Development binds locally; production defaults to 0.0.0.0 when HOST is absent.
DATABASE_URL=postgresql://lms_app:local_app_password@127.0.0.1:5436/lms
DIRECT_URL=postgresql://lms_migrator:local_owner_password@127.0.0.1:5436/lms
TEST_DATABASE_URL=postgresql://lms_app:local_app_password@127.0.0.1:5436/lms_test
TEST_DIRECT_URL=postgresql://lms_migrator:local_owner_password@127.0.0.1:5436/lms_test
POSTGRES_PASSWORD=local_owner_password
APP_DB_PASSWORD=local_app_password
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
TRUST_PROXY_HOPS=0
SESSION_TTL_HOURS=168
MAIL_ENCRYPTION_KEY=replace_with_64_hex_characters
EMAIL_DRIVER=mailbox
RESEND_API_KEY=
EMAIL_FROM=
MAILBOX_DIR=.local/mailbox
LOG_LEVEL=info
